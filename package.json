{
  "name": "pokerperf-tools",
  "private": true,
  "type": "module",
  "description": "Moteur d'équité + outils JS pour les pages-outils PokerPerf (buildés vers /assets).",
  "scripts": {
    "test": "vitest run",
    "oracle": "tsx src/equity/oracle.ts",
    "typecheck": "tsc --noEmit",
    "build:calc": "esbuild src/ui/calculator.ts --bundle --format=iife --minify --target=es2019 --outfile=assets/js/equity-calculator.js",
    "build:potodds": "esbuild src/ui/potodds.ts --bundle --format=iife --minify --target=es2019 --outfile=assets/js/pot-odds.js",
    "build:js": "npm run build:calc && npm run build:potodds && npm run build:semibluff && npm run build:range && npm run build:icm && npm run build:sidepot && npm run build:bankroll && npm run build:plo && npm run build:pushfold",
    "build:semibluff": "esbuild src/ui/semibluff.ts --bundle --format=iife --minify --target=es2019 --outfile=assets/js/semi-bluff.js",
    "build:range": "esbuild src/ui/range.ts --bundle --format=iife --minify --target=es2019 --outfile=assets/js/range-calculator.js",
    "build:icm": "esbuild src/ui/icm.ts --bundle --format=iife --minify --target=es2019 --outfile=assets/js/icm-calculator.js",
    "build:sidepot": "esbuild src/ui/sidepot.ts --bundle --format=iife --minify --target=es2019 --outfile=assets/js/side-pot-calculator.js",
    "build:bankroll": "esbuild src/ui/bankroll.ts --bundle --format=iife --minify --target=es2019 --outfile=assets/js/bankroll-calculator.js",
    "build:plo": "esbuild src/ui/plo.ts --bundle --format=iife --minify --target=es2019 --outfile=assets/js/plo-calculator.js",
    "build:pushfold": "esbuild src/ui/pushfold.ts --bundle --format=iife --minify --target=es2019 --outfile=assets/js/push-fold.js"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
